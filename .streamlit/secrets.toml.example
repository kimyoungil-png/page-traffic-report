# Gemini
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_MODEL = "gemini-flash-latest"

# Google Search Console
# Cloud Run recommended: do NOT configure a JSON key here.
# The app will use Application Default Credentials (ADC), so grant the
# Cloud Run runtime Service Account access to the Search Console property.
#
# GSC_SITE_URL is optional. If omitted, the app automatically chooses the
# accessible property that best matches the first Adobe URL
# (longest URL-prefix property first, then matching sc-domain property).
# GSC_SITE_URL = "https://www.samsung.com/jp/"
# GSC_SITE_URL = "sc-domain:samsung.com"

# Local/off-Cloud-Run fallback Option A: JSON string
# GSC_SERVICE_ACCOUNT_JSON = '''{"type":"service_account", ... }'''

# Local/off-Cloud-Run fallback Option B: TOML table
[gsc_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = """-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
client_email = "YOUR_SERVICE_ACCOUNT@YOUR_PROJECT_ID.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CLIENT_CERT_URL"

# Existing Technical SEO Checker screenshot API can be reused.
SCREENSHOT_API_URL = "https://technical-seo-unlighthouse-api-231228645606.asia-northeast1.run.app/screenshot"
